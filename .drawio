        <!-- LANE 4: CỔNG PAYER & KHO DƯỢC -->
        <mxCell id="lane4" value="&lt;b style=&quot;font-size: 13px; color: #B45309;&quot;&gt;CỔNG CHI TRẢ &amp; KHO&lt;br/&gt;(PAYERS &amp; INVENTORY)&lt;/b&gt;" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#FACC15;strokeWidth=1.5;startSize=50;" vertex="1" parent="1">
          <mxGeometry x="50" y="890" width="1850" height="260" as="geometry" />
