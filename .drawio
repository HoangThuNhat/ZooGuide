  <diagram id="diagram_userflow" name="2. Luồng Nghiệp vụ Người dùng">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="p2_header" value="&lt;b style=&quot;font-size: 20px; color: #0F172A;&quot;&gt;QUY TRÌNH NGHIỆP VỤ ĐẦU - CUỐI (END-TO-END BUSINESS PROCESS FLOW)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;HÀNH TRÌNH TỪ TIẾP ĐÓN ĐẾN THẨM ĐỊNH CHI PHÍ, CẤP PHÁT THUỐC &amp; ĐỐI SOÁT BẢO HIỂM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1850" height="65" as="geometry" />
        </mxCell>

        <!-- SWIMLANES (CÁC LÀN BƠI PHÂN VAI) -->
