  <!-- ========================================== -->
  <!-- TRANG 1: SƠ ĐỒ PHÂN RÃ PRODUCT BACKLOG     -->
  <!-- ========================================== -->
  <diagram id="diagram_backlog" name="1. Phân rã Product Backlog">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="p1_header" value="&lt;b style=&quot;font-size: 20px; color: #0F172A;&quot;&gt;HỆ THỐNG QUẢN LÝ BẢO HIỂM Y TẾ &amp; GIÁM ĐỊNH ĐƠN THUỐC (HICAMS)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;SƠ ĐỒ PHÂN RÃ PRODUCT BACKLOG (EPIC &amp; USER STORY MAPPING)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1540" height="70" as="geometry" />
        </mxCell>

        <!-- LEGEND / CHÚ THÍCH -->
        <mxCell id="p1_legend" value="&lt;b&gt;Chú thích Ưu tiên:&lt;/b&gt; &amp;nbsp;&amp;nbsp; &lt;span style=&quot;background-color: #EF4444; color: white; padding: 2px 8px; border-radius: 4px;&quot;&gt;&lt;b&gt;Must-have&lt;/b&gt;&lt;/span&gt; Bắt buộc trong MVP &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;background-color: #3B82F6; color: white; padding: 2px 8px; border-radius: 4px;&quot;&gt;&lt;b&gt;Should-have&lt;/b&gt;&lt;/span&gt; Quan trọng đợt 2 &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;background-color: #10B981; color: white; padding: 2px 8px; border-radius: 4px;&quot;&gt;&lt;b&gt;SP&lt;/b&gt;&lt;/span&gt; Story Points ước lượng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="1540" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 1: EPIC 01 ==================== -->
        <mxCell id="col1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#BAE6FD;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="epic1_hdr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EPIC 01&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;XÁC THỰC QUYỀN LỢI&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Eligibility Verification)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- US-01 -->
        <mxCell id="us01" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #0369A1;&quot;&gt;US-01: Tra cứu Quyền lợi Realtime&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Dược sĩ quầy thuốc&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Quét mã thẻ BHYT gửi điện 270.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Nhận phản hồi 271 (&amp;lt; 1.5s): trạng thái Eligible, hạn mức Deductible và OOP Max còn lại.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;ELIGIBILITY_CHECK&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="255" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-01b -->
        <mxCell id="us01b" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #0369A1;&quot;&gt;US-01b: Quản lý Thẻ &amp; Hợp đồng&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 3 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Nhân viên tiếp đón&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Lưu thông tin thẻ, thời hạn và thứ tự bảo hiểm chính/phụ.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Xác định thứ tự ưu tiên COB (1: Primary, 2: Secondary).&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;MEMBER_POLICY&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="425" width="260" height="145" as="geometry" />
        </mxCell>

        <!-- US-01c (Cache) -->
        <mxCell id="us01c" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #0369A1;&quot;&gt;US-01c: Cache Hạn mức Quyền lợi&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;&lt;b&gt;[Should-have | 3 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Mục tiêu:&lt;/b&gt; Cache kết quả kiểm tra 15 phút trong Redis để giảm tải truy vấn lặp lại sang cổng Payer.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="585" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 2: EPIC 02 ==================== -->
        <mxCell id="col2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#99F6E4;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="165" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="epic2_hdr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EPIC 02&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;DANH MỤC &amp; LÂM SÀNG&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Formulary &amp; Clinical DUR)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0F766E;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="370" y="175" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- US-02 -->
        <mxCell id="us02" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #0F766E;&quot;&gt;US-02: Đối chiếu Danh mục &amp; Bậc thuốc&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Động cơ quy tắc danh mục&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Đối chiếu hoạt chất đơn thuốc với danh mục gói bảo hiểm.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Xác định Tier 1/2/3/4, cờ PA, Step therapy, giới hạn ngày/số lượng và mã DAW.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;FORMULARY_DRUG&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="375" y="255" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-03 -->
        <mxCell id="us03" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #0F766E;&quot;&gt;US-03: Rà soát Lâm sàng DUR Realtime&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 8 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Bác sĩ / Dược sĩ&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Kiểm tra tương tác thuốc - thuốc, dị ứng, quá liều và cấp phát quá sớm (early refill).&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Cảnh báo Hard Stop hoặc yêu cầu ghi đè lý do (Override Reason).&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;DUR_ALERT&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="375" y="425" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 3: EPIC 03 ==================== -->
        <mxCell id="col3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#E9D5FF;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="165" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="epic3_hdr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EPIC 03&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;THẨM ĐỊNH &amp; TÀI CHÍNH&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Claim Adjudication)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="175" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- US-04 -->
        <mxCell id="us04" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #6D28D9;&quot;&gt;US-04: Thẩm định Tự động Claim Line&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 13 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Động cơ Giám định chi phí&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Bóc tách tài chính từng dòng đơn.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Tính toán chính xác: allowed_amount, deductible_applied, copay, coinsurance, payer_paid; cập nhật bộ đếm tích lũy.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;CLAIM, CLAIM_LINE&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="255" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-05 -->
        <mxCell id="us05" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #6D28D9;&quot;&gt;US-05: Phối hợp Quyền lợi (COB)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;&lt;b&gt;[Should-have | 8 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Dược sĩ quầy thuốc&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Tự động chuyển claim sang Payer phụ sau khi Payer chính chi trả xong.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Giảm tối đa tiền bệnh nhân tự chi trả, duy trì vết đối soát primary_claim_id.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;CLAIM.primary_claim_id&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="425" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-08 -->
        <mxCell id="us08" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #6D28D9;&quot;&gt;US-08: Hoàn hủy Giao dịch (Reversal)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Dược sĩ quầy thuốc&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Hủy giao dịch đã duyệt khi bệnh nhân đổi đơn thuốc ngay trong ca.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Hoàn trả tồn kho on_hand, giảm trừ hạn mức tích lũy đã ghi nhận.&lt;br/&gt;&lt;b&gt;Trạng thái:&lt;/b&gt; &lt;i&gt;CLAIM: REVERSED&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="595" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 4: EPIC 04 ==================== -->
        <mxCell id="col4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="165" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="epic4_hdr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EPIC 04&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;PHÊ DUYỆT TRƯỚC (PA)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(Prior Authorization)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#B45309;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="990" y="175" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- US-06a -->
        <mxCell id="us06a" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #B45309;&quot;&gt;US-06a: Khởi tạo Hồ sơ Lâm sàng PA&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;&lt;b&gt;[Should-have | 8 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Bác sĩ / Nhân viên bảo hiểm&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Tạo hồ sơ đề nghị phê duyệt thuốc đặc trị / ngoài danh mục.&lt;br/&gt;&lt;b&gt;Nội dung:&lt;/b&gt; Đính kèm chẩn đoán ICD-10, bằng chứng thất bại với phác đồ bậc thấp.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;PRIOR_AUTHORIZATION&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="995" y="255" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-06b -->
        <mxCell id="us06b" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #B45309;&quot;&gt;US-06b: Tiếp nhận Mã PA &amp; Tái nộp&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;&lt;b&gt;[Should-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Dược sĩ quầy thuốc&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Nhận auth_approval_code được Payer duyệt.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Hệ thống tự động gán mã PA vào đơn bị từ chối trước đó và gửi tái thẩm định thành công.&lt;br/&gt;&lt;b&gt;Trạng thái:&lt;/b&gt; &lt;i&gt;PA: APPROVED&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="995" y="425" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 5: EPIC 05 ==================== -->
        <mxCell id="col5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="165" width="300" height="820" as="geometry" />
        </mxCell>
        <mxCell id="epic5_hdr" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EPIC 05&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;QUẦY THUỐC &amp; VẬN HÀNH&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;(POS, Inventory &amp; Audit)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="1305" y="175" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- US-07 -->
        <mxCell id="us07" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #15803D;&quot;&gt;US-07: Thu tiền Quầy, Trừ kho, In EOB&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Thu ngân / Dược sĩ quầy&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Thu đúng khoản patient_copay từ người bệnh.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Tự động trừ tồn kho on_hand, in bảng kê EOB kèm hóa đơn, chuyển claim sang PAID.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;DRUG_PHARMACY.on_hand&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="255" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-09 -->
        <mxCell id="us09" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #15803D;&quot;&gt;US-09: Ghi Log Bảo mật &amp; Che mờ PHI&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #DC2626;&quot;&gt;&lt;b&gt;[Must-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Cán bộ An toàn Thông tin&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Lưu vết toàn bộ bản tin request/response trao đổi với cổng Payer.&lt;br/&gt;&lt;b&gt;Yêu cầu:&lt;/b&gt; Tự động che mờ (mask) CCCD, SĐT, Tên bệnh nhân trước khi ghi đĩa.&lt;br/&gt;&lt;b&gt;Bảng dữ liệu:&lt;/b&gt; &lt;i&gt;PHARMACY_CLAIM_TXN&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="425" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- US-10 -->
        <mxCell id="us10" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: #15803D;&quot;&gt;US-10: Đối soát Thanh toán Công nợ&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #2563EB;&quot;&gt;&lt;b&gt;[Should-have | 5 SP]&lt;/b&gt;&lt;/span&gt;&lt;hr style=&quot;border: 0.5px solid #CBD5E1;&quot;&gt;&lt;b&gt;Vai trò:&lt;/b&gt; Kế toán viện / Nhà thuốc&lt;br/&gt;&lt;b&gt;Hành động:&lt;/b&gt; Tự động đối soát bảng kê giải ngân điện tử 835 ERA từ Payer.&lt;br/&gt;&lt;b&gt;Kết quả:&lt;/b&gt; Phát hiện chênh lệch xuất toán, theo dõi chu kỳ dòng tiền về (TAT).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1;shadow=1;fontSize=11;fontColor=#1E293B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="595" width="260" height="145" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================== -->
  <!-- TRANG 2: SƠ ĐỒ LUỒNG NGHIỆP VỤ NGƯỜI DÙNG  -->
