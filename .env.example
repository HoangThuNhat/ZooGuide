# ZooGuide Supabase PostgreSQL Connection String
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_username;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;

# Supabase Storage Configuration
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_STORAGE_BUCKET=narration-audio
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt_key
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_token
JWT_SECRET_KEY=your_jwt_signing_secret_key_min_32_chars

# Docker Compose Project Isolation & Port Configuration
# Port 3001 is used for ZooGuide Demo Frontend to avoid conflicting with Open WebUI on port 3000
COMPOSE_PROJECT_NAME=zooguide-demo
API_PORT=8080
FRONTEND_PORT=3001

# Frontend Environment Variables
VITE_API_BASE_URL=/api
VITE_CARTO_API_KEY=your_carto_or_map_api_key

# Gmail SMTP Configuration for Ticket QR Delivery
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_sender@gmail.com
EMAIL_SMTP_PASSWORD=your_google_app_password
EMAIL_FROM_NAME=ZooGuide - Thảo Cầm Viên Sài Gòn
EMAIL_FROM_ADDRESS=your_sender@gmail.com
EMAIL_ENABLE_SSL=true
