# ZooGuide Supabase PostgreSQL Connection String
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_username;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;

# Service Port Configuration
API_PORT=8080
FRONTEND_PORT=3001

# Frontend Environment Variables
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
