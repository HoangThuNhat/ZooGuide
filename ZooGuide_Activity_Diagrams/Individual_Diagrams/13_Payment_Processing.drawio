    <mxCell id="d13_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;fontSize=10;fontFamily=Arial;" vertex="1" parent="1">
      <mxGeometry x="206" y="120" width="28" height="28" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_choose" value="Chọn loại vé, số lượng và nhập thông tin người mua (Họ tên, Email, SĐT) -&gt; Bấm &#x27;Tiến hành đặt vé&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="170" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_create_order" value="Validate số lượng (1-50), tính TotalAmount, sinh mã đơn ZG-yyyyMMdd-xxxxxx, mã chuyển khoản ZGxxxxxx và URL ảnh VietQR Napas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="170" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_show_qr" value="Lưu bản ghi TICKET_ORDERS (Pending, hạn 15 phút) -&gt; Mở Modal VietQR kèm mã QR chuyển khoản và đồng hồ đếm ngược" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="250" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_dec_pay_method" value="Phương thức thực hiện thanh toán?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;fontFamily=Arial;align=center;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="330" width="160" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_scan_bank" value="Khách quét mã VietQR bằng Mobile Banking chuyển tiền -&gt; Cổng thanh toán gửi Webhook POST /api/payments/webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="410" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_click_sim" value="Khách hoặc Tester nhấn nút &#x27;Giả lập thanh toán Sandbox&#x27; trên giao diện phục vụ kiểm thử" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="480" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_verify_amount" value="Đối soát số tiền giao dịch nhận được so với tổng tiền đơn hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="445" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_dec_pay_ok" value="Thanh toán thành công và đủ tiền?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;fontFamily=Arial;align=center;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="520" y="525" width="180" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_fail" value="Cập nhật PaymentStatus = Failed trong TICKET_ORDERS và thông báo lỗi thanh toán" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="595" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_paid" value="Cập nhật PaymentStatus = Paid, lưu PaidAt, sinh TransactionReference" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="665" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_issue_tkts" value="Tự động phát hành vé: Tạo N bản ghi trong bảng TICKETS (mã TKT-xxxx-xxxx, Status=Valid), gửi email xác nhận kèm vé điện tử" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="735" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_success_ui" value="Hiển thị Modal &#x27;Thanh toán thành công&#x27; kèm danh sách vé điện tử có mã QR và nút &#x27;Kích hoạt ngay&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="805" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d13_act_visitor_done" value="Khách xem vé điện tử hoặc bấm &#x27;Kích hoạt phiên tham quan ngay&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
