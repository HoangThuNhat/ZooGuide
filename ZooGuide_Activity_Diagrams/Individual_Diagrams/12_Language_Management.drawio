    <mxCell id="d12_act_load_ui" value="Lưu languageCode = &#x27;en&#x27; vào localStorage và truy vấn từ điển chuỗi giao diện tương ứng từ máy chủ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
