    <mxCell id="d3_act_in_new" value="Nhập: Mã phân khu (Code: A, B, C...), Tên khu, Mô tả, Tọa độ Lat/Lng, Bán kính, Tọa độ mapX/mapY -&gt; Bấm &#x27;Tạo khu vực&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
