    <mxCell id="title_diag_14" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;14. TRA CỨU THÔNG TIN SỞ THÚ (ZOO INFORMATION LOOKUP)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình tìm kiếm, lọc danh mục động vật, xem hồ sơ chi tiết và liên kết bản đồ/thuyết minh&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
