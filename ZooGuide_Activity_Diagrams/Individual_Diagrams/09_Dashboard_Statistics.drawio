    <mxCell id="1" parent="0" />
    <mxCell id="title_diag_09" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;09. THỐNG KÊ DASHBOARD (DASHBOARD STATISTICS)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình tổng hợp chỉ số vận hành, doanh thu bán vé, phiên tham quan và cảnh báo thú y&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
