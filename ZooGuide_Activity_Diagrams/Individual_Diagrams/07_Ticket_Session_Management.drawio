  <diagram id="diag_07" name="07 - Ticket Session Management"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1180" math="0" shadow="0"><root>
