      <mxGeometry x="520" y="240" width="180" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d7_act_err_404" value="Hiển thị thông báo: Vé không tồn tại trên hệ thống (404 TICKET_NOT_FOUND)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="310" width="300" height="52" as="geometry" />
