    </mxCell>
    <mxCell id="d7_act_err_status" value="Hiển thị thông báo: Vé đã qua sử dụng, đã hủy hoặc bị khóa (400 Bad Request)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
