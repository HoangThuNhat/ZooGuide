    <mxCell id="title_diag_15" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;15. ĐIỀU HƯỚNG THAM QUAN (ZOO NAVIGATION)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình định vị GPS, chọn điểm xuất phát, tính toán tuyến đường ngắn nhất Dijkstra và dẫn đường&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
