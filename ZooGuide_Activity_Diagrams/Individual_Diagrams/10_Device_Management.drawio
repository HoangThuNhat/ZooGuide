    <mxCell id="title_diag_10" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;10. QUẢN LÝ THIẾT BỊ (DEVICE MANAGEMENT)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình nhận heartbeat định kỳ, giám sát thiết bị trực tuyến và ngắt kết nối an toàn&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
