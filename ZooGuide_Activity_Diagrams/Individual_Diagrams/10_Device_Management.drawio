    <mxCell id="d10_act_heartbeat" value="Khởi tạo mã định danh thiết bị installationId và định kỳ mỗi 30 giây gửi Heartbeat lên máy chủ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
