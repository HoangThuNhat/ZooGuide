    <mxCell id="d10_act_open_app" value="Du khách mở ứng dụng ZooGuide trên trình duyệt thiết bị di động" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
