    </mxCell>
    <mxCell id="d5_act_open" value="Truy cập phân hệ Quản lý vé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="170" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_display" value="Truy vấn bảng TICKETS kết hợp TICKET_TYPES -&gt; Hiển thị danh sách vé: Mã vé, Khách hàng, Loại vé, Hạn dùng, Trạng thái" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="170" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_dec_action" value="Chọn nghiệp vụ quản lý vé?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;fontFamily=Arial;align=center;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="240" width="160" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_in_new" value="Chọn Loại vé, nhập Tên khách hàng, SĐT, Số lượng vé, Hạn dùng tùy chỉnh -&gt; Bấm &#x27;Phát hành vé&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="320" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_gen_code" value="Kiểm tra loại vé và sinh mã vé ngẫu nhiên bảo mật (TKT-xxxxxxxx)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="320" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_dec_dup" value="Trùng mã vé trong DB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;fontFamily=Arial;align=center;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="520" y="390" width="180" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_save_tkt" value="INSERT bản ghi vé với Status = Valid vào bảng TICKETS -&gt; Xuất mã QR vé điện tử phục vụ in hoặc gửi khách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="460" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_sel_status" value="Chọn vé, chọn trạng thái mới: Valid, Used, Expired, Cancelled, Locked -&gt; Bấm &#x27;Cập nhật&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="550" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d5_act_save_status" value="Validate quy tắc chuyển đổi và UPDATE trường Status, UpdatedAt trong bảng TICKETS -&gt; Thông báo thành công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="550" width="300" height="52" as="geometry" />
    </mxCell>
