    <mxCell id="d2_act_sel_upd" value="Chọn cá thể, chỉnh sửa thông tin hoặc chọn chuồng nuôi mới -&gt; Bấm &#x27;Cập nhật&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="610" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d2_act_save_upd" value="Xác thực dữ liệu, UPDATE bản ghi ANIMALS trong Database và hiển thị thông báo cập nhật thành công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="610" width="300" height="52" as="geometry" />
