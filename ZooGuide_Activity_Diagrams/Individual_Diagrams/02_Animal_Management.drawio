    </mxCell>
    <mxCell id="d2_act_save_health" value="Kiểm tra số đo sinh học, UPDATE trường HealthStatus, LastHealthCheckAt vào bảng ANIMALS và thông báo thành công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
