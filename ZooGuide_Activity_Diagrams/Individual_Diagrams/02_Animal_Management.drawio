    <mxCell id="d2_act_in_health" value="Thú y ghi nhận kết quả khám: Tình trạng sức khỏe, Cân nặng, Thân nhiệt, Bác sĩ khám -&gt; Bấm &#x27;Lưu hồ sơ&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
