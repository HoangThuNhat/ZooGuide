    <mxCell id="title_diag_08" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;08. QUẢN LÝ THUYẾT MINH (AUDIO GUIDE MANAGEMENT)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình phát thuyết minh đa ngôn ngữ, kiểm soát phiên, đồng bộ kịch bản và xử lý fallback&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="15" width="780" height="45" as="geometry" />
