  <diagram id="diag_04" name="04 - POI Management"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="960" math="0" shadow="0"><root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title_diag_04" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;04. QUẢN LÝ ĐIỂM THAM QUAN (POI MANAGEMENT)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình quản lý điểm mốc di tích, kiểm định tọa độ WGS84, gắn bài thuyết minh và cập nhật trạng thái&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="15" width="780" height="45" as="geometry" />
    </mxCell>
    <mxCell id="lane_diag_04_0" value="Người dùng (Administrator)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;horizontal=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="40" y="70" width="360" height="840" as="geometry" />
    </mxCell>
    <mxCell id="lane_diag_04_1" value="Hệ thống (System)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;horizontal=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontStyle=1;fontSize=12;fontFamily=Arial;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
      <mxGeometry x="400" y="70" width="420" height="840" as="geometry" />
    </mxCell>
    <mxCell id="d4_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;fontSize=10;fontFamily=Arial;" vertex="1" parent="1">
      <mxGeometry x="206" y="120" width="28" height="28" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_open" value="Truy cập mục Quản lý điểm tham quan (POI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="170" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_display" value="Truy vấn bảng POINTS_OF_INTEREST và POI_NARRATIONS -&gt; Hiển thị danh sách điểm tham quan, tọa độ Lat/Lng và trạng thái kiểm định" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="170" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_dec_action" value="Chọn nghiệp vụ POI?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;fontFamily=Arial;align=center;spacing=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="240" width="160" height="55" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_in_new" value="Nhập Tên POI, Thể loại (gate, landmark...), Mô tả, Tọa độ Lat/Lng, Phân khu -&gt; Bấm &#x27;Tạo POI&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="320" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_save_poi" value="Validate tọa độ WGS84, INSERT bản ghi vào bảng POINTS_OF_INTEREST và vẽ Marker trên bản đồ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="320" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_in_verify" value="Chọn POI đã khảo sát GPS thực địa -&gt; Bấm &#x27;Xác nhận kiểm định tọa độ&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="410" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_save_verify" value="UPDATE trường IsVerified = true, lưu nguồn khảo sát vào Database và cập nhật huy hiệu &#x27;Đã kiểm định&#x27; trên giao diện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="410" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_in_nar" value="Nhập kịch bản văn bản, chọn file âm thanh .mp3 thuyết minh POI -&gt; Bấm &#x27;Tải lên&#x27;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="500" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d4_act_save_nar" value="Upload file âm thanh lên Supabase Storage và lưu metadata vào bảng POI_NARRATIONS -&gt; Thông báo thành công" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="500" width="300" height="52" as="geometry" />
    </mxCell>
