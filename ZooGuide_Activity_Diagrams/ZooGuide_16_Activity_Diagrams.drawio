    <mxCell id="d16_act_select" value="Giai đoạn 1: Khách duyệt các hạng vé, chọn số lượng, điền thông tin người mua và gửi yêu cầu đặt vé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="170" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_order_qr" value="Tạo đơn hàng TICKET_ORDERS (Pending), tính tiền, sinh VietQR Napas và đồng hồ đếm ngược 15 phút" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="170" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_pay" value="Giai đoạn 2: Khách quét VietQR chuyển khoản (hoặc nhấn nút Giả lập Sandbox trên màn hình)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="250" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_confirm" value="Xác nhận thanh toán -&gt; Cập nhật đơn hàng Paid -&gt; Tự động phát hành mã vé tham quan (TKT-xxxx-xxxx) và gửi email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="250" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_activate" value="Giai đoạn 3: Khách nhận vé điện tử, bấm &#x27;Kích hoạt phiên ngay&#x27; (hoặc quét mã QR tại cổng kiểm soát)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="90" y="330" width="260" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_validate" value="Xác thực mã vé hợp lệ và còn hạn -&gt; Khởi tạo TICKET_SESSION lưu vào Database -&gt; Nâng cấp quyền người dùng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="460" y="330" width="300" height="52" as="geometry" />
    </mxCell>
    <mxCell id="d16_act_experience" value="Giai đoạn 4: Trở thành &#x27;Validated Visitor&#x27; và trải nghiệm: Nghe thuyết minh âm thanh 12 ngôn ngữ, Bản đồ dẫn đường Dijkstra và Tra cứu động vật" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;fontFamily=Arial;align=center;spacing=4;" vertex="1" parent="1">
