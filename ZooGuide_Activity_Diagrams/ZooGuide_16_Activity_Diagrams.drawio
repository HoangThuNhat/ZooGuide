  <diagram id="diag_16" name="16 - Ticket Purchase and Usage"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="830" math="0" shadow="0"><root>
