    <mxCell id="1" parent="0" />
    <mxCell id="title_diag_05" value="&lt;div style=&#x27;font-family: Arial, sans-serif;&#x27;&gt;&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #000000;&#x27;&gt;05. QUẢN LÝ VÉ (TICKET MANAGEMENT)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 11px; color: #333333;&#x27;&gt;Quy trình tra cứu vé, phát hành vé thủ công/tại quầy, đổi trạng thái và thu hồi vé&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="15" width="780" height="45" as="geometry" />
    </mxCell>
